# Set these as environment variables for the backend process.
# Spring Boot does not automatically load this file.
FRONTEND_URL=http://127.0.0.1:5173

PASSWORD_RESET_ENABLED=false
MAIL_FROM=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://127.0.0.1:8080/api/v1/auth/calendar/callback
# Base64 encoding of 32 random bytes; keep stable and secret across deployments.
INTEGRATIONS_ENCRYPTION_KEY=

PUSH_ENABLED=false
# Absolute path to a mounted Firebase service account JSON file; backend only.
FIREBASE_CREDENTIALS_FILE=
