# Database Configuration
DB_NAME=badminton_booking
DB_USER=badminton
DB_PASSWORD=badminton_dev
DB_HOST=localhost
DB_PORT=5432

# Backend Configuration
SERVER_PORT=8080
BOOKING_HOLD_DURATION_MINUTES=10

# payOS Payment Gateway (Cho giai đoạn 4)
PAYOS_CLIENT_ID=your_client_id_here
PAYOS_API_KEY=your_api_key_here
PAYOS_CHECKSUM_KEY=your_checksum_key_here
# Chỉ bật sau khi đổi khóa và kiểm tra tích hợp webhook.
PAYOS_ENABLED=false

# Frontend Configuration
# API root; for local Vite development, /api is proxied to localhost:8080.
# For production use the public HTTPS backend URL followed by /api.
VITE_API_URL=/api
